blueprint:
  name: EcoMain - PV Controlled Air Conditioner (Fingerbot)222
  description: >
    Automatically control an air conditioner using ADAPROX Fingerbots
    according to EcoMain real-time power.

    When grid power is below the ON threshold for a period of time,
    the selected Fingerbot actions are executed.

    When grid power is above the OFF threshold for a period of time,
    another set of Fingerbot actions are executed.

    This blueprint is designed for EcoMain users.
  domain: automation

  input:
    power_sensor:
      name: EcoMain Grid Power Sensor
      selector:
        entity:
          domain: sensor

    on_threshold:
      name: PV Available Threshold (W)
      default: -500
      selector:
        number:
          min: -5000
          max: 5000
          step: 100
          unit_of_measurement: W

    off_threshold:
      name: Grid Import Threshold (W)
      default: 500
      selector:
        number:
          min: -5000
          max: 5000
          step: 100
          unit_of_measurement: W

    duration:
      name: Required Duration
      default: 40
      selector:
        number:
          min: 5
          max: 600
          step: 5
          unit_of_measurement: seconds

    power_button:
      name: Power Fingerbot
      selector:
        entity:
          domain: switch

    temp_up_button:
      name: Temperature Up Fingerbot
      selector:
        entity:
          domain: switch
          multiple: false

    temp_down_button:
      name: Temperature Down Fingerbot
      selector:
        entity:
          domain: switch
          multiple: false

    power_on:
      name: Press Power when PV is available
      default: true
      selector:
        boolean:

    cool_down_steps:
      name: Temperature Down Presses
      default: 0
      selector:
        number:
          min: 0
          max: 10
          step: 1

    power_off:
      name: Press Power when PV disappears
      default: true
      selector:
        boolean:

    warm_up_steps:
      name: Temperature Up Presses
      default: 0
      selector:
        number:
          min: 0
          max: 10
          step: 1

mode: single

trigger:
  - platform: numeric_state
    entity_id: !input power_sensor
    below: !input on_threshold
    for:
      seconds: !input duration
    id: pv_on

  - platform: numeric_state
    entity_id: !input power_sensor
    above: !input off_threshold
    for:
      seconds: !input duration
    id: pv_off

action:
  - variables:
      power_on_var: !input power_on
      power_off_var: !input power_off

  - choose:

      # PV Available
      - conditions:
          - condition: trigger
            id: pv_on
        sequence:

          # Optionally press Power
          - if:
              - condition: template
                value_template: "{{ power_on_var }}"
            then:
              - service: switch.turn_on
                target:
                  entity_id: !input power_button

          # Optionally lower the temperature
          - repeat:
              count: !input cool_down_steps
              sequence:
                - delay: "00:00:02"
                - service: switch.turn_on
                  target:
                    entity_id: !input temp_down_button

      # PV Not Available
      - conditions:
          - condition: trigger
            id: pv_off
        sequence:

          # Optionally press Power
          - if:
              - condition: template
                value_template: "{{ power_off_var }}"
            then:
              - service: switch.turn_off
                target:
                  entity_id: !input power_button

          # Optionally raise the temperature
          - repeat:
              count: !input warm_up_steps
              sequence:
                - delay: "00:00:02"
                - service: switch.turn_on
                  target:
                    entity_id: !input temp_up_button
