blueprint:
  name: Solar Surplus Air Conditioner Control
  description: >
    Automatically control an air conditioner using physical button pushers
    based on household grid power and available solar surplus.

    When grid power is below the ON threshold for a period of time,
    the selected actions are executed.

    When grid power is above the OFF threshold for a period of time,
    another set of actions are executed.

    This blueprint is designed for Home Assistant users.

  domain: automation

  input:
    power_sensor:
      name: Grid Power Sensor
      selector:
        entity:
          domain: sensor

    on_threshold:
      name: Surplus Export Threshold (W)
      default: -500
      selector:
        number:
          min: -5000
          max: 5000
          step: 100
          unit_of_measurement: W

    off_threshold:
      name: Grid Import Threshold (W)
      default: 500
      selector:
        number:
          min: -5000
          max: 5000
          step: 100
          unit_of_measurement: W

    duration:
      name: Required Duration
      default: 40
      selector:
        number:
          min: 5
          max: 600
          step: 5
          unit_of_measurement: seconds

    power_button:
      name: Power Button
      default: []
      selector:
        entity:
          domain: switch

    temp_up_button:
      name: Temperature Up Button
      default: []
      selector:
        entity:
          domain: switch

    temp_down_button:
      name: Temperature Down Button
      default: []
      selector:
        entity:
          domain: switch

    power_on:
      name: Turn on AC when solar surplus is available
      default: true
      selector:
        boolean:

    cool_down_steps:
      name: Temperature Down Presses
      default: 0
      selector:
        number:
          min: 0
          max: 10
          step: 1

    power_off:
      name: Turn off AC when grid import is detected
      default: true
      selector:
        boolean:

    warm_up_steps:
      name: Temperature Up Presses
      default: 0
      selector:
        number:
          min: 0
          max: 10
          step: 1

mode: single

trigger:
  - platform: numeric_state
    entity_id: !input power_sensor
    below: !input on_threshold
    for:
      seconds: !input duration
    id: pv_on

  - platform: numeric_state
    entity_id: !input power_sensor
    above: !input off_threshold
    for:
      seconds: !input duration
    id: pv_off

action:
  - variables:
      power_on_var: !input power_on
      power_off_var: !input power_off
      power_button_entity: !input power_button
      temp_down_entity: !input temp_down_button
      temp_up_entity: !input temp_up_button
      cool_steps: !input cool_down_steps
      warm_steps: !input warm_up_steps

  # Validate required buttons for the selected actions
  - choose:
      - conditions:
          - condition: template
            value_template: >
              {{
                trigger.id == 'pv_on'
                and power_on_var == true
                and power_button_entity in [none, []]
              }}
        sequence:
          - stop: >
              Power Button is required when
              "Turn on AC when solar surplus is available" is enabled.

      - conditions:
          - condition: template
            value_template: >
              {{
                trigger.id == 'pv_off'
                and power_off_var == true
                and power_button_entity in [none, []]
              }}
        sequence:
          - stop: >
              Power Button is required when
              "Turn off AC when grid import is detected" is enabled.

      - conditions:
          - condition: template
            value_template: >
              {{
                trigger.id == 'pv_on'
                and cool_steps | int > 0
                and temp_down_entity in [none, []]
              }}
        sequence:
          - stop: >
              Temperature Down Button is required when
              Temperature Down Presses is greater than 0.

      - conditions:
          - condition: template
            value_template: >
              {{
                trigger.id == 'pv_off'
                and warm_steps | int > 0
                and temp_up_entity in [none, []]
              }}
        sequence:
          - stop: >
              Temperature Up Button is required when
              Temperature Up Presses is greater than 0.

  - choose:

      # Solar Surplus Available
      - conditions:
          - condition: trigger
            id: pv_on

        sequence:
          # Optionally press Power
          - if:
              - condition: template
                value_template: "{{ power_on_var == true }}"
            then:
              - service: switch.turn_on
                target:
                  entity_id: "{{ power_button_entity }}"

              - delay: "00:00:05"

          # Optionally lower the temperature
          - if:
              - condition: template
                value_template: "{{ cool_steps | int > 0 }}"
            then:
              - repeat:
                  count: "{{ cool_steps | int }}"
                  sequence:
                    - service: switch.turn_on
                      target:
                        entity_id: "{{ temp_down_entity }}"

                    - delay: "00:00:08"

      # Grid Import
      - conditions:
          - condition: trigger
            id: pv_off

        sequence:
          # Optionally press Power
          - if:
              - condition: template
                value_template: "{{ power_off_var == true }}"
            then:
              - service: switch.turn_off
                target:
                  entity_id: "{{ power_button_entity }}"

              - delay: "00:00:05"

          # Optionally raise the temperature
          - if:
              - condition: template
                value_template: "{{ warm_steps | int > 0 }}"
            then:
              - repeat:
                  count: "{{ warm_steps | int }}"
                  sequence:
                    - service: switch.turn_on
                      target:
                        entity_id: "{{ temp_up_entity }}"

                    - delay: "00:00:08"
